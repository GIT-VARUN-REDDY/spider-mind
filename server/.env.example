# Spider Mind API configuration. Copy to .env (never commit .env).
# Defaults shown in brackets apply when the variable is unset.

# development | test | production. Production enforces the checks marked (prod).
NODE_ENV=development
# [4000] HTTP port and [0.0.0.0] bind address.
PORT=4000
HOST=0.0.0.0

# [mongodb://127.0.0.1:27017/spidermind] (prod: required) MongoDB 6/7 connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/spidermind

# (prod: required, >= 32 chars each, must differ) HS256 secrets. Generate: openssl rand -base64 48
# Unset outside production falls back to built-in dev secrets (logged as a warning).
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# [12] bcrypt cost for password hashes (prod: >= 10). Lower only for tests.
BCRYPT_COST=12

# Comma separated allowed web origins. [* in development, none in production]
# "*" is rejected in production. Native apps send no Origin and are unaffected.
CORS_ORIGINS=http://localhost:3000

# [false] Express "trust proxy": a hop count (1 behind one load balancer), true, or a CIDR/list.
# Set it correctly behind a proxy or rate limiting will see the proxy's IP for everyone.
TRUST_PROXY=false

# [60000] rate limit window; [300] requests per window per IP overall; [20] for /auth/*.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=20

# [256kb] JSON body limit.
BODY_LIMIT=256kb

# [true] run the reminder scheduler in this process. Safe to run on several instances.
REMINDER_SCHEDULER_ENABLED=true
# [15000] how often due reminders are claimed (ms).
REMINDER_TICK_MS=15000
# [24] reminders that came due longer ago than this (server was down) are marked sent without a push.
REMINDER_CATCHUP_HOURS=24

# Optional FCM push: Firebase service account JSON, raw or base64 encoded. Needs firebase-admin
# (installed as an optional dependency). Unset = push disabled (logged once).
FCM_SERVICE_ACCOUNT_JSON=

# [info; silent when NODE_ENV=test] debug | info | warn | error | silent
LOG_LEVEL=info
# [10000] max time to drain connections on SIGTERM.
SHUTDOWN_TIMEOUT_MS=10000

# Optional Google Sign-In OAuth client ID (Android / Web).
GOOGLE_CLIENT_ID=

# Optional Brevo transactional email configuration
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=Spider Mind
