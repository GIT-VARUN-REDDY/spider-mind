{
  "name": "spider-mind-server",
  "version": "1.0.0",
  "private": true,
  "description": "Spider Mind (PROJECT SPIDER) API: Express, MongoDB, Socket.IO",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "lint": "for f in $(find src test -name '*.js'); do node --check \"$f\" || exit 1; done",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test test/unit",
    "test:integration": "node --test --test-concurrency=1 test/integration"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
